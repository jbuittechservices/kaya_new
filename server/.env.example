# --- Core ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Generate a long random string for production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Where the SQLite file is stored (defaults to server/data/kaya.db)
DATA_DIR=./data

# --- SMS / OTP delivery (Twilio) ---
# Leave blank in development: OTP codes are printed to the server console instead.
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use ONE of the following two — a Messaging Service is recommended (handles sender
# selection, compliance, and number pooling for you), a single from-number also works.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# --- Paystack (wallet top-ups & payments) ---
# Leave blank in development: top-ups are credited instantly for easy testing.
# Get live/test keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/app/wallet

# --- Seed script ---
SEED_ADMIN_PASSWORD=KayaAdmin!2026
