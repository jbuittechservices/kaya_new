# URL of the Kaya API server (see /server). Defaults to http://localhost:4000 if unset.
VITE_API_URL=https://kaya-new.onrender.com

# Google Maps API key — enables real maps, address autocomplete, and route drawing.
# Get one at https://console.cloud.google.com/google/maps-apis (enable "Maps JavaScript API",
# "Places API", and "Directions API" on the same project/key).
# Leave blank to fall back to the illustrated placeholder map used in local dev.
VITE_GOOGLE_MAPS_API_KEY=AIzaSyA4vJ953vqwIwSm5vhEHQyFDEXVC-S9_qg
